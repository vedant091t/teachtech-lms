# .gitignore
# Generated for TeachTech PHP project

# Environment & Secrets
.env
.env.*
.env.local

# Composer / Dependencies
/vendor/

# Uploaded files & runtime data
/asset/*
!/asset/.gitkeep
!/asset/logo.png
!/asset/.htaccess

/uploads/
/pdfs/
/videos/

# Logs
/logs/*
!/logs/.gitkeep

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Caches and test artifacts
.phpunit.result.cache
/.phpunit.cache/
/coverage/
